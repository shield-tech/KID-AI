# Ollama is local-only by default. Models must already be installed; K.I.D never pulls models.
OLLAMA_BASE_URL=http://127.0.0.1:11434
KID_DEFAULT_MODEL=
KID_CHAT_MODEL=
KID_KEEP_ALIVE=5m
KID_NUM_CTX=3072
KID_NUM_PREDICT=384
KID_TEMPERATURE=0.7
KID_NUM_THREAD=0

KID_MEMORY_DB_PATH=kid_memory.sqlite3
KID_KNOWLEDGE_ROOT=knowledge
KID_TASK_DB_PATH=.kid/tasks.json
KID_MEMORY_ENABLED=true
KID_KNOWLEDGE_ENABLED=true

# Piper: install piper and place the selected .onnx and its .onnx.json alongside in this directory.
# K.I.D does not download voice models. For local fallback, install espeak-ng.
KID_VOICE_OUTPUT_ENABLED=true
KID_PIPER_VOICE=en_US-lessac-medium
KID_PIPER_VOICE_DIR=voices
KID_ESPEAK_VOICE=en-us
KID_SPEECH_VOLUME=0.8
KID_SPEECH_SPEED=1.0

# Voice input is push-to-talk only; no microphone capture is started automatically.
KID_VOICE_INPUT_ENABLED=false
VOSK_MODEL_DIR=models/vosk
KID_MICROPHONE_DEVICE=default
KID_WAKE_WORD_ENABLED=false
KID_WAKE_WORD=kid

KID_ENABLE_VISION=true
KID_AUDIT_LOG_PATH=kid_audit.log
# Robotics defaults to simulation/disconnected. Do not change unless setting up hardware deliberately.
KID_ROBOT_SIMULATION=true
KID_ROBOT_PORT=
KID_WARMUP_MODEL=false
KID_REQUEST_TIMEOUT=180
