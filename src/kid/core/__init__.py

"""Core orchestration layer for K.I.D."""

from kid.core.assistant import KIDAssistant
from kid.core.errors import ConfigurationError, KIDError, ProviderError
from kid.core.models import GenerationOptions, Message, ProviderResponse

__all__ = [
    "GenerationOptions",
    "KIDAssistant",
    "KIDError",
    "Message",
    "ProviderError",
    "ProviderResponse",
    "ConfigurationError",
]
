from __future__ import annotations

import os
from dataclasses import dataclass

from kid.core.errors import ConfigurationError

DEFAULT_SYSTEM_PROMPT = (
    "You are K.I.D, a helpful, reliable, and privacy-aware AI assistant. "
    "Provide clear, practical answers. Ask clarifying questions when needed."
)


@dataclass(frozen=True)
class Settings:
    provider: str
    model: str
    api_key: str | None
    temperature: float = 0.7
    max_tokens: int | None = None
    system_prompt: str = DEFAULT_SYSTEM_PROMPT
    debug: bool = False


def _get_env_float(name: str, default: float) -> float:
    raw = os.getenv(name)
    if raw is None or raw == "":
        return default
    try:
        return float(raw)
    except ValueError as exc:
        raise ConfigurationError(f"Environment variable {name} must be a float.") from exc


def _get_env_int(name: str, default: int | None) -> int | None:
    raw = os.getenv(name)
    if raw is None or raw == "":
        return default
    try:
        return int(raw)
    except ValueError as exc:
        raise ConfigurationError(f"Environment variable {name} must be an integer.") from exc


def _resolve_provider(provider_override: str | None) -> str:
    provider = (provider_override or os.getenv("KID_PROVIDER") or "openai").strip().lower()
    if provider not in {"openai", "gemini"}:
        raise ConfigurationError("KID_PROVIDER must be either 'openai' or 'gemini'.")
    return provider


def load_settings(
    *,
    provider: str | None = None,
    model: str | None = None,
    system_prompt: str | None = None,
) -> Settings:
    provider_name = _resolve_provider(provider)

    if provider_name == "openai":
        api_key_name = "OPENAI_API_KEY"
        default_model = "gpt-4o-mini"
    else:
        api_key_name = "GEMINI_API_KEY"
        default_model = "gemini-1.5-flash"

    api_key = os.getenv(api_key_name)
    if not api_key:
        raise ConfigurationError(f"Missing required API key: {api_key_name}")

    resolved_model = (model or os.getenv("KID_MODEL") or default_model).strip()
    if not resolved_model:
        raise ConfigurationError("KID_MODEL cannot be empty.")

    resolved_system_prompt = (
        system_prompt or os.getenv("KID_SYSTEM_PROMPT") or DEFAULT_SYSTEM_PROMPT
    )
    debug = (os.getenv("KID_DEBUG", "false").strip().lower() in {"1", "true", "yes", "on"})

    return Settings(
        provider=provider_name,
        model=resolved_model,
        api_key=api_key,
        temperature=_get_env_float("KID_TEMPERATURE", 0.7),
        max_tokens=_get_env_int("KID_MAX_TOKENS", None),
        system_prompt=resolved_system_prompt,
        debug=debug,
    )
